{
  "name": "pi-rex-btw",
  "version": "0.2.0",
  "private": true,
  "description": "Clean-context Pi side sessions in new Rex panes.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "rex"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-rex-btw#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-rex-btw"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm effect:diagnostics && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:",
    "pi-cosmic-core": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}

{
  "name": "cosmic-pi",
  "version": "0.2.0",
  "private": true,
  "description": "A pnpm workspace for Pi extensions.",
  "homepage": "https://github.com/mattleong/cosmic-pi#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm effect:diagnostics && pnpm lint && pnpm format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings scripts packages tools",
    "lint:fix": "oxlint --type-aware --fix scripts packages tools",
    "test": "node --test scripts/*.test.ts && pnpm test:anti-slop && node scripts/test-packages.ts",
    "test:anti-slop": "node --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts",
    "typecheck": "pnpm typecheck:anti-slop && pnpm typecheck:scripts && pnpm --workspace-concurrency=4 --no-sort -r run typecheck",
    "typecheck:anti-slop": "tsc --noEmit -p tools/oxlint/anti-slop/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "effect:diagnostics": "pnpm --workspace-concurrency=4 --no-sort -r run effect:diagnostics",
    "pack:smoke": "node scripts/verify-packed-core.ts",
    "presentation:gallery": "node scripts/presentation-gallery.ts",
    "validate": "pnpm version:check && pnpm check && pnpm test && pnpm pack:smoke",
    "version:check": "node scripts/check-versions.ts",
    "version:set": "node scripts/set-version.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.2",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "jiti": "2.7.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}

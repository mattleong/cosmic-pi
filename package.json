{
  "name": "cosmic-pi",
  "version": "0.2.0",
  "private": true,
  "description": "A pnpm workspace for pi extensions.",
  "homepage": "https://github.com/mattleong/cosmic-pi#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm build && pnpm check:built",
    "check:built": "pnpm layout:check && pnpm typecheck:built && pnpm effect:lsp:check && pnpm effect:diagnostics && pnpm lint && pnpm format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts && pnpm -r lint",
    "lint:fix": "oxlint --fix scripts && pnpm -r lint:fix",
    "layout:check": "node scripts/check-package-layout.mjs",
    "test": "pnpm build && pnpm test:built",
    "test:built": "pnpm --workspace-concurrency=2 -r exec vitest run",
    "typecheck": "pnpm build && pnpm typecheck:built",
    "typecheck:built": "pnpm effect:lsp:patch && pnpm --workspace-concurrency=4 --no-sort -r exec tsc --noEmit",
    "effect:lsp:patch": "effect-language-service patch",
    "effect:lsp:check": "effect-language-service check",
    "effect:diagnostics": "pnpm --workspace-concurrency=4 --no-sort -r --if-present effect:diagnostics",
    "local:smoke": "node scripts/verify-local-advisor.mjs",
    "pack:smoke": "pnpm local:smoke && node scripts/verify-packed-core.mjs",
    "prepare": "effect-language-service patch && pnpm --filter pi-cosmic-core build",
    "validate": "pnpm version:check && pnpm build && pnpm check:built && pnpm test:built && pnpm pack:smoke",
    "version:check": "node scripts/check-versions.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.0",
    "@effect/vitest": "catalog:",
    "@types/node": "~22.19.0",
    "effect": "catalog:",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}

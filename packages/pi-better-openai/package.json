{
  "name": "pi-better-openai",
  "version": "0.2.0",
  "description": "Personal pi extension that improves OpenAI with fast mode, usage stats, and footer polish.",
  "keywords": [
    "fast",
    "gpt",
    "image",
    "openai",
    "pi",
    "pi-extension",
    "pi-package",
    "priority",
    "service-tier"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-better-openai#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-better-openai"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#pi-ai-openai-codex-responses": "@earendil-works/pi-ai/api/openai-codex-responses",
    "#pi-ai-constrained-sampling": "@earendil-works/pi-ai/api/constrained-sampling",
    "#pi-ai-openai-responses-shared": "@earendil-works/pi-ai/api/openai-responses-shared"
  },
  "exports": {
    ".": "./index.ts",
    "./fast-models": "./src/fast/models.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "effect": "catalog:",
    "pi-code-previews": "workspace:*",
    "pi-cosmic-core": "workspace:*",
    "pi-cosmic-ui": "workspace:*",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}

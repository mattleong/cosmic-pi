{
  "name": "pi-cosmic-core",
  "version": "0.2.0",
  "description": "Shared Effect-first runtime foundations for cosmic-pi extensions.",
  "keywords": [
    "effect",
    "pi",
    "pi-extension",
    "runtime"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-cosmic-core#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-cosmic-core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.8",
    "@effect/vitest": "catalog:",
    "@types/node": "~22.19.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsdown": "^0.22.0",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".pi-subagents/**",
    ".roo/**",
    ".windsurf/**",
    "**/tests/test262/fixtures/**"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "rules": {
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-eager-effect-finalizer-condition": "error",
    "anti-slop/no-escaping-render-context": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-lossy-expanded-arguments": "error",
    "anti-slop/no-manual-abort-listener": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-raw-host-notify": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-runtime-type-only-tests": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/require-code-preview-shell": "error",
    "eslint/default-case-last": "error",
    "eslint/eqeqeq": "error",
    "eslint/no-else-return": "error",
    "eslint/no-implicit-coercion": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@earendil-works/pi-tui",
            "importNames": ["truncateToWidth"],
            "message": "Use clipToWidth from pi-cosmic-ui/manager so clipped text ends in \"…\" everywhere."
          },
          {
            "name": "effect",
            "allowTypeImports": true,
            "message": "Import Effect modules through namespace subpaths, such as `import * as Effect from \"effect/Effect\"`."
          }
        ]
      }
    ],
    "eslint/no-restricted-properties": [
      "error",
      {
        "object": "Reflect",
        "property": "get",
        "message": "Use typed property access, or parse dynamic input into a named domain type first."
      },
      {
        "object": "Reflect",
        "property": "apply",
        "message": "Call the function directly with typed arguments."
      }
    ],
    "eslint/no-self-compare": "error",
    "eslint/no-shadow": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "_meta"]
      }
    ],
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-return": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-has-own": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-barrel-file": "error",
    "oxc/no-map-spread": "off",
    "promise/catch-or-return": "error",
    "promise/valid-params": "off",
    "typescript/ban-types": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports",
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false,
        "checkThenables": true
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": [
      "error",
      {
        "allowAny": false,
        "allowNullish": false
      }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowAny": false,
        "allowNullish": false
      }
    ],
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-useless-collection-argument": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-structured-clone": "error"
  },
  "overrides": [
    {
      "files": ["packages/**", "scripts/**"],
      "rules": {
        "anti-slop-effect/no-manual-tag-comparison": "error",
        "anti-slop-effect/no-manual-tagged-construction": "error",
        "anti-slop-effect/no-service-constructor-imports": "error",
        "anti-slop-effect/prefer-effect-match": "error"
      }
    },
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "error",
        "anti-slop/no-callable-type-predicate": "error",
        "anti-slop-effect/prefer-effect-fn": "error",
        "anti-slop-effect/no-effect-runner-imports": "error",
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Reflect",
            "property": "get",
            "message": "Use typed property access, or parse dynamic input into a named domain type first."
          },
          {
            "object": "Reflect",
            "property": "apply",
            "message": "Call the function directly with typed arguments."
          },
          {
            "property": "runCallback",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runFork",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runPromise",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runPromiseExit",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runSync",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runSyncExit",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runCallbackWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runForkWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runPromiseWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runPromiseExitWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runSyncWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          },
          {
            "property": "runSyncExitWith",
            "message": "Keep Effect runners at named Pi host or standalone-process boundaries. Return the Effect to its caller or run it through the pi-cosmic-core session runtime."
          }
        ]
      }
    },
    {
      "files": [
        "packages/pi-code-previews/src/boundary/settings-one-shot.ts",
        "packages/pi-code-previews/src/boundary/shiki.ts",
        "packages/pi-cosmic-core/src/runtime/runtime.ts",
        "packages/pi-cosmic-core/src/testing/**",
        "packages/pi-cosmic-ui/src/boundary/host-surface.ts",
        "packages/pi-cosmic-ui/src/boundary/host-ui-ticker-pool.ts"
      ],
      "rules": {
        "anti-slop-effect/no-effect-runner-imports": "off",
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Reflect",
            "property": "get",
            "message": "Use typed property access, or parse dynamic input into a named domain type first."
          },
          {
            "object": "Reflect",
            "property": "apply",
            "message": "Call the function directly with typed arguments."
          }
        ]
      }
    },
    {
      "files": ["packages/**"],
      "rules": {
        "eslint/no-console": "error"
      }
    },
    {
      "files": ["**/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@earendil-works/pi-tui",
                "importNames": ["truncateToWidth"],
                "message": "Use clipToWidth from pi-cosmic-ui/manager so clipped text ends in \"…\" everywhere."
              },
              {
                "name": "pi-cosmic-core",
                "importNames": ["stripAnsi"],
                "message": "stripAnsi removes only CSI sequences, so OSC and other terminal controls survive. Use stripTerminalControls or sanitizeTerminalLine from pi-cosmic-core, or escapeControlChars from pi-code-previews to keep controls visible."
              },
              {
                "name": "effect",
                "allowTypeImports": true,
                "message": "Import Effect modules through namespace subpaths, such as `import * as Effect from \"effect/Effect\"`."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/tests/**/*.ts", "packages/*/src/testing/**/*.ts"],
      "rules": {
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "never"
          }
        ],
        "typescript/no-unsafe-type-assertion": "off",
        "anti-slop/no-callable-type-predicate": "off"
      }
    },
    {
      "files": ["packages/pi-cosmic-core/src/schema/foreign-callable.ts"],
      "rules": {
        "anti-slop/no-callable-type-predicate": "off"
      }
    },
    {
      "files": ["**/packages/pi-cosmic-ui/src/manager/chrome.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "pi-cosmic-core",
                "importNames": ["stripAnsi"],
                "message": "stripAnsi removes only CSI sequences, so OSC and other terminal controls survive. Use stripTerminalControls or sanitizeTerminalLine from pi-cosmic-core, or escapeControlChars from pi-code-previews to keep controls visible."
              },
              {
                "name": "effect",
                "allowTypeImports": true,
                "message": "Import Effect modules through namespace subpaths, such as `import * as Effect from \"effect/Effect\"`."
              }
            ]
          }
        ]
      }
    }
  ]
}

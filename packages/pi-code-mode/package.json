{
  "name": "pi-code-mode",
  "version": "0.2.0",
  "description": "Code Mode for pi: a confined code_mode agent tool that orchestrates Pi built-ins and an explicit session-scoped background-task adapter from one interpreted program.",
  "keywords": [
    "code-mode",
    "pi",
    "pi-extension",
    "pi-package",
    "settings",
    "tools"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-code-mode#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-code-mode"
  },
  "files": [
    "index.ts",
    "src/",
    "runtime/src/",
    "runtime/LICENSE",
    "runtime/THIRD_PARTY_NOTICES.md",
    "runtime/PROVENANCE.md",
    "runtime/README.md",
    "runtime/SUPPORT.md",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "acorn": "catalog:",
    "effect": "catalog:",
    "pi-background-task": "workspace:*",
    "pi-code-previews": "workspace:*",
    "pi-cosmic-core": "workspace:*",
    "pi-cosmic-ui": "workspace:*",
    "pi-mcp": "workspace:*",
    "typebox": "catalog:",
    "typescript-compiler-api": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}

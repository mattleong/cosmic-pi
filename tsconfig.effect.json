{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "refactors": true,
        "diagnosticsName": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "excludeExternalLibrariesWhenSkipLibCheck": true,
        "namespaceImportPackages": ["effect", "@effect/*"],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "asyncFunction": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "deterministicKeys": "error",
          "duplicatePackage": "error",
          "extendsNativeError": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "importFromBarrel": "error",
          "layerMergeAllWithDependencies": "error",
          "leakingRequirements": "error",
          "multipleEffectProvide": "error",
          "newPromise": "error",
          "nodeBuiltinImport": "error",
          "outdatedApi": "error",
          "preferSchemaOverJson": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "serviceNotAsClass": "error",
          "unknownInEffectCatch": "error",
          "unsafeEffectTypeAssertion": "error"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "strictEffectProvide": "error"
              }
            }
          },
          {
            "include": [
              "**/packages/pi-subagents/src/boundary/git-worktree-publish-helper.mjs",
              "**/packages/pi-subagents/src/boundary/supervisor-mcp-helper.mjs",
              "**/packages/pi-subagents/tests/fixtures/hanging-probe-fixture.mjs"
            ],
            "options": {
              "diagnosticSeverity": {
                "processEnv": "off"
              }
            }
          },
          {
            "include": [
              "**/packages/pi-subagents/tests/fixtures/hanging-probe-fixture.mjs",
              "**/packages/pi-better-openai/tests/fixtures/sharp-decoder-fixture.mjs"
            ],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "off",
                "globalTimers": "off"
              }
            }
          }
        ]
      }
    ]
  }
}

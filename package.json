{
  "name": "cosmic-pi",
  "version": "0.2.0",
  "private": true,
  "description": "A pnpm workspace for Pi extensions.",
  "homepage": "https://github.com/mattleong/cosmic-pi#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git"
  },
  "type": "module",
  "scripts": {
    "check": "pnpm layout:check && pnpm diagnostics:guard && pnpm typecheck && pnpm effect:lsp:check && pnpm effect:diagnostics && pnpm lint && pnpm format:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts packages tools",
    "lint:fix": "oxlint --fix scripts packages tools",
    "layout:check": "node scripts/check-package-layout.mjs",
    "test": "pnpm test:anti-slop && pnpm --workspace-concurrency=2 -r exec vitest run",
    "test:anti-slop": "node --test tools/oxlint/anti-slop/rules/*.test.ts",
    "typecheck": "pnpm effect:lsp:patch && pnpm typecheck:anti-slop && pnpm --workspace-concurrency=4 --no-sort -r exec tsc --noEmit",
    "typecheck:anti-slop": "tsc --noEmit -p tools/oxlint/anti-slop/tsconfig.json",
    "effect:lsp:patch": "effect-language-service patch",
    "effect:lsp:check": "effect-language-service check",
    "effect:diagnostics": "pnpm --workspace-concurrency=4 --no-sort -r --if-present effect:diagnostics",
    "diagnostics:guard": "node scripts/check-no-disabled-diagnostics.mjs",
    "local:smoke": "node scripts/verify-local-advisor.mjs",
    "pack:smoke": "pnpm local:smoke && node scripts/verify-packed-core.mjs",
    "prepare": "effect-language-service patch",
    "validate": "pnpm version:check && pnpm check && pnpm test && pnpm pack:smoke",
    "version:check": "node scripts/check-versions.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "jiti": "2.7.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}

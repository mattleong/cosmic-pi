{
  "name": "pi-cosmic-ui",
  "version": "0.2.0",
  "description": "Composable, responsive UI elements for pi.",
  "keywords": [
    "cosmic-ui",
    "footer",
    "pi",
    "pi-extension",
    "pi-package",
    "terminal-ui"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-cosmic-ui#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-cosmic-ui"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./activity": "./src/activity/protocol.ts",
    "./activity/testing": "./src/activity/testing.ts",
    "./activity/view": "./src/activity/view-protocol.ts",
    "./boundary/host-input-dock": "./src/boundary/host-input-dock.ts",
    "./boundary/host-settings-command": "./src/boundary/host-settings-command.ts",
    "./boundary/host-status": "./src/boundary/host-status.ts",
    "./boundary/host-surface": "./src/boundary/host-surface.ts",
    "./boundary/host-viewport": "./src/boundary/host-viewport.ts",
    "./client": "./src/footer/client.ts",
    "./manager": "./src/manager/chrome.ts",
    "./manager/key-labels": "./src/manager/key-labels.ts",
    "./manager/keymap": "./src/manager/keymap.ts",
    "./manager/list-detail": "./src/manager/list-detail.ts",
    "./manager/list-navigation": "./src/manager/list-navigation.ts",
    "./manager/list-detail-shell": "./src/manager/list-detail-shell.ts",
    "./manager/model-picker": "./src/manager/model-picker.ts",
    "./manager/panel": "./src/manager/panel.ts",
    "./manager/searchable-select": "./src/manager/searchable-select.ts",
    "./manager/settings-adapter": "./src/manager/settings-adapter.ts",
    "./manager/settings-surface": "./src/manager/settings-surface.ts",
    "./manager/style": "./src/manager/style.ts",
    "./manager/table": "./src/manager/table.ts",
    "./manager/viewport": "./src/manager/viewport.ts",
    "./protocol": "./src/protocol/protocol.ts",
    "./testing": "./src/testing/custom-surface.ts",
    "./tool": "./src/tool/presentation.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "effect": "catalog:",
    "pi-cosmic-core": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}

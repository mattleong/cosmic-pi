{
  "name": "pi-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Session-scoped MCP gateway, user-only authentication, and Code Mode integration for Pi.",
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./code-mode": "./src/protocol.ts"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "effect": "catalog:",
    "pi-code-previews": "workspace:*",
    "pi-cosmic-core": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}

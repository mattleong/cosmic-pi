{
  "name": "pi-subagents",
  "version": "0.2.0",
  "description": "Session-scoped profile-routed background subagents for pi.",
  "keywords": [
    "agents",
    "background-agents",
    "pi",
    "pi-extension",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-subagents"
  },
  "files": [
    "index.ts",
    "src/",
    "docs/",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "smoke:herdr-codex-hooks": "PI_SUBAGENTS_REAL_CODEX_HOOKS=1 vitest run tests/herdr-codex-hooks-real-smoke.test.ts",
    "smoke:herdr-codex": "PI_SUBAGENTS_REAL_HERDR_CODEX_SMOKE=1 vitest run tests/herdr-codex-real-smoke.test.ts",
    "smoke:local-claude-replay": "PI_SUBAGENTS_REAL_CLAUDE_REPLAY_SMOKE=1 vitest run tests/local-claude-replay-real-smoke.test.ts",
    "smoke:local-claude-steering": "PI_SUBAGENTS_REAL_CLAUDE_STEERING_SMOKE=1 vitest run tests/local-claude-steering-real-smoke.test.ts --maxWorkers=1 --reporter=verbose --silent=false",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "jiti": "2.7.0",
    "pi-ask-user": "workspace:*",
    "pi-better-openai": "workspace:*",
    "pi-code-previews": "workspace:*",
    "pi-cosmic-core": "workspace:*",
    "pi-cosmic-ui": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}

{
  "name": "pi-mcp-previews",
  "version": "0.2.0",
  "description": "Always-on previews for Pi's native MCP tools and resources.",
  "keywords": [
    "code-preview",
    "mcp",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/mattleong/cosmic-pi/tree/main/packages/pi-mcp-previews#readme",
  "bugs": {
    "url": "https://github.com/mattleong/cosmic-pi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattleong/cosmic-pi.git",
    "directory": "packages/pi-mcp-previews"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "prepublishOnly": "pnpm validate",
    "pack:dry": "pnpm pack --dry-run"
  },
  "dependencies": {
    "effect": "catalog:",
    "pi-code-previews": "workspace:*",
    "pi-cosmic-core": "workspace:*",
    "pi-cosmic-ui": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
